<local:MediaIslandSettingsPage x:Class="MediaIsland.SettingsPages.MediaSettingsPage"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:ci="http://classisland.tech/schemas/xaml/core"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:controls="using:FluentAvalonia.UI.Controls"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:local="clr-namespace:MediaIsland.SettingsPages"
                               mc:Ignorable="d"
                               d:DesignHeight="450" d:DesignWidth="800"
                               TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                               Background="{DynamicResource MaterialDesignPaper}"
                               FontFamily="{StaticResource HarmonyOsSans}"
                               TextElement.FontWeight="Regular"
                               TextElement.FontSize="14">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:MediaSettingsPage}}">
        <StackPanel Classes="settings-container animated-intro">
            <ci:IconText Glyph="&#xEBC9;" Text="当前媒体" Margin="0 0 0 8" />
            <Border Margin="0 0 0 8"
                    Padding="14"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="64"
                            Height="64"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Image Source="{Binding CurrentMediaThumbnail}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding HasCurrentMediaThumbnail}" />
                            <ci:FluentIcon Glyph="&#xEBC9;"
                                           FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           IsVisible="{Binding !HasCurrentMediaThumbnail}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentMediaTitle}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentMediaArtistAlbum}"
                                   Margin="0 4 0 0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                            <ci:FluentIcon Glyph="{Binding CurrentMediaStatusGlyph}"
                                           FontSize="14"
                                           Margin="0 0 4 0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentMediaPlaybackStatus}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" · "
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentMediaTimeline}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <Border Width="16"
                                    Height="16"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    Margin="0 0 4 0"
                                    ToolTip.Tip="{Binding CurrentMediaSourceIconStatus}">
                                <Image Source="{Binding CurrentMediaSourceIcon}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding HasCurrentMediaSourceIcon}" />
                            </Border>
                            <TextBlock Text="{Binding CurrentMediaSourceDisplay}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding CurrentMediaSourceId}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <ci:IconText Glyph="&#xEDBA;" Text="播放源" Margin="0 16 0 8" />
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE561;}"
                                         Header="播放源列表"
                                         Description="插件监听的播放源列表，可控制是否显示来自特定播放源的信息、是否搜索歌词，并可自定义显示名称与图标。修改后点「保存」，重载组件后生效。">
                <StackPanel Orientation="Vertical">
                    <DataGrid Margin="12,6,12,6"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              MaxHeight="320"
                              ItemsSource="{Binding Settings.MediaSourceList}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="播放源" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*" Margin="8,4">
                                            <Border Width="24"
                                                    Height="24"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    ToolTip.Tip="{Binding IconStatus, StringFormat='图标：{0}'}">
                                                <Image Source="{Binding DisplayIcon}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Source}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Source}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="自定义名称" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="4,0"
                                                 VerticalAlignment="Center"
                                                 Text="{Binding CustomDisplayName, Mode=TwoWay}"
                                                 PlaceholderText="留空时自动识别"
                                                 LostFocus="CustomDisplayNameTextBoxOnLostFocus" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="启用" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  ToolTip.Tip="显示来自该播放源的媒体信息" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="歌词搜索" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsLyricsSearchEnabled, Mode=TwoWay}"
                                                  ToolTip.Tip="为该播放源搜索歌词" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,8,0">
                                            <Button Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Theme="{StaticResource TransparentButton}"
                                                    Click="ChooseIconButtonOnClick"
                                                    ToolTip.Tip="自定义图标">
                                                <ci:FluentIcon Glyph="&#xE9C4;" />
                                            </Button>
                                            <Button Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Theme="{StaticResource TransparentButton}"
                                                    IsEnabled="{Binding IconPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Click="ClearIconButtonOnClick"
                                                    ToolTip.Tip="清除自定义图标">
                                                <ci:FluentIcon Glyph="&#xE7FF;" />
                                            </Button>
                                            <Button Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Theme="{StaticResource TransparentButton}"
                                                    Click="DeleteButtonOnClick"
                                                    ToolTip.Tip="移除播放源">
                                                <ci:FluentIcon Glyph="&#xE61C;"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="12,0,12,6">
                        <Button HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Theme="{StaticResource TransparentButton}"
                                Classes="accent"
                                Click="AddButtonOnClick">
                            <ci:IconText Text="添加当前播放源" Glyph="&#xE00C;" />
                        </Button>
                        <Button HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Theme="{StaticResource TransparentButton}"
                                Classes="accent"
                                Click="SaveButtonOnClick">
                            <ci:IconText Text="保存" Glyph="&#xEEB5;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE1C0;}"
                                         Header="移除封面的 Spotify 水印"
                                         Description="部分版本的 Spotify 桌面版会在传给 SMTC 的封面下方加入其商标，如果你在插件呈现的封面上看到了，可以打开这个开关。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsCutSpotifyTrademarkEnabled, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <ci:IconText Glyph="&#xEAEF;" Text="隐私" Margin="0 16 0 8" />
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE2A5;}"
                                         Header="匿名使用情况分析"
                                         Description="本插件使用 Sentry 收集与本插件相关的使用情况与错误信息，以帮助改善本插件，相关信息将被匿名上传。此功能不会收集您的个人信息。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsTodayEatSentry, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</local:MediaIslandSettingsPage>
