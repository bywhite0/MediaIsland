<local:MediaIslandSettingsPage x:Class="MediaIsland.SettingsPages.MediaLinkShareSettingsPage"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:ci="http://classisland.tech/schemas/xaml/core"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:controls="using:FluentAvalonia.UI.Controls"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:local="clr-namespace:MediaIsland.SettingsPages"
                               mc:Ignorable="d"
                               d:DesignHeight="450" d:DesignWidth="800"
                               TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                               Background="{DynamicResource MaterialDesignPaper}"
                               FontFamily="{StaticResource HarmonyOsSans}"
                               TextElement.FontWeight="Regular"
                               TextElement.FontSize="14">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:MediaLinkShareSettingsPage}}">
        <StackPanel Classes="settings-container animated-intro">
            <TextBlock Text="发送端：把本机正在播放的歌曲、歌词与音频共享给其它程序（如 OBS 字幕、自制歌词条）或另一台电脑上的 ClassIsland。接收方的设置在「Link-Like MediaLink」页。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0 0 0 16" />
            <ci:IconText Glyph="&#xEF38;" Text="共享服务" Margin="0 0 0 8" />
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE409;}"
                                         Header="通过 WebSocket 共享媒体信息"
                                         Description="开启后，其它程序或设备可以实时获取当前播放的歌曲与歌词。需要凭下方的连接密钥才能读取。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.MediaLinkIsEnabled, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE038;}"
                                         Header="当前状态"
                                         Description="共享服务的运行情况与连接地址。">
                <controls:FASettingsExpander.Footer>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding MediaLinkStatusText}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE625;}"
                                         Header="监听地址与端口"
                                         Description="默认为 127.0.0.1:21757。">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="140"
                                 PlaceholderText="127.0.0.1"
                                 Text="{Binding Settings.MediaLinkListenAddress, Mode=TwoWay}" />
                        <TextBox Width="80"
                                 PlaceholderText="21757"
                                 Text="{Binding Settings.MediaLinkPort, Mode=TwoWay}" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <TextBlock Text="{Binding MediaLinkExposureWarning}"
                       IsVisible="{Binding HasMediaLinkExposureWarning}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap"
                       Margin="0 4 0 8" />
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE5D2;}"
                                         Header="允许的网页来源（Origin）"
                                         Description="只有从网页连接时才需要填。出于安全考虑，网页默认一律被拒绝；把网页地址填进来才放行，多个用分号隔开。用浏览器直接打开本地 HTML 文件时，请填 null。用脚本或其它程序连接不受此限制。">
                <controls:FASettingsExpander.Footer>
                    <TextBox Width="280"
                             PlaceholderText="null;http://localhost:3000"
                             Text="{Binding Settings.MediaLinkAllowedOrigins, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <ci:IconText Glyph="&#xEA00;" Text="连接凭据" Margin="0 16 0 8" />
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE103;}"
                                         Header="连接密钥"
                                         Description="其它程序需要凭这串密钥才能读取播放信息。请勿公开分享。重新生成后，所有已连接的程序都会断开，需要重新填写新密钥。">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="220"
                                 IsReadOnly="True"
                                 Text="{Binding Settings.MediaLinkToken}" />
                        <Button Content="复制" Click="CopyMediaLinkTokenOnClick" />
                        <Button Content="重新生成" Click="RegenerateMediaLinkTokenOnClick" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE225;}"
                                         Header="一键配置码"
                                         Description="把本机的地址与密钥打包成一串文本，在另一台设备的「Link-Like MediaLink」页粘贴即可，无需手抄密钥。这串文本包含密钥且未加密，请仅发给信任的设备。">
                <controls:FASettingsExpander.Footer>
                    <Button Content="复制配置码" Click="CopyMediaLinkConfigCodeOnClick" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <TextBlock Text="{Binding MediaLinkConfigCodeHint}"
                       IsVisible="{Binding HasMediaLinkConfigCodeHint}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap"
                       Margin="0 4 0 8" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 16 0 8">
                <ci:IconText Glyph="&#xF00C;" Text="音频" />
                <local:ExperimentalBadge />
            </StackPanel>
            <controls:FASettingsExpander IconSource="{ci:LucideIconSource &#xE296;}"
                                         Header="播放延迟预算"
                                         Description="本机作为发送端时，向所有接收端声明的目标出声延迟（毫秒）。开启了「对齐出声时刻」的接收端会把声音安排在这个时点出声。调小更跟手；太小时接收端装不下，会自动退回普通播放。修改后对新建立的连接生效。">
                <controls:FASettingsExpander.Footer>
                    <NumericUpDown Width="140"
                                   Increment="50"
                                   FormatString="0 'ms'"
                                   Value="{Binding Settings.MediaLinkAudioClockBudgetMs, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</local:MediaIslandSettingsPage>
