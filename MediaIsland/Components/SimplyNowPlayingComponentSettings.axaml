<ci:ComponentBase x:Class="MediaIsland.Components.SimplyNowPlayingComponentSettings"
                  x:TypeArguments="local:SimplyNowPlayingComponentConfig"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:controls="using:FluentAvalonia.UI.Controls"
                  xmlns:local="clr-namespace:MediaIsland.Components"
                  mc:Ignorable="d"
                  d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SimplyNowPlayingComponentSettings}}">
        <StackPanel>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE817;}" Header="暂停时隐藏组件"
                                         Description="当当前媒体暂停时，隐藏本组件。由于 ClassIsland 的设计特性，隐藏后仍存在一段空白。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsHideWhenPaused, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEBCB;}" Header="显示当前播放状态"
                                         Description="显示当前媒体的播放状态，关闭则显示音符图标。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsShowPlaybackStatus, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE77B;}" Header="显示样式"
                                         Description="切换信息显示样式。">
                <controls:FASettingsExpander.Footer>
                    <ComboBox MinWidth="110" SelectedIndex="{Binding Settings.InfoType}">
                        <ComboBoxItem>艺术家 - 歌曲名</ComboBoxItem>
                        <ComboBoxItem>歌曲名 - 艺术家</ComboBoxItem>
                        <ComboBoxItem>歌曲名</ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel>
                                <TextBlock Text="歌曲名" TextWrapping="Wrap" />
                                <TextBlock Text="艺术家" TextWrapping="Wrap" FontSize="10" />
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE091;}"
                                         Header="内容最大宽度"
                                         Description="限制歌曲名与艺术家区域的最大宽度，避免过长内容溢出覆盖右侧组件。拖到最左为 0，表示不限制。">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider Width="160"
                                Minimum="0"
                                Maximum="1000"
                                Value="{Binding Settings.MaxContentWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="20"
                                IsSnapToTickEnabled="True"
                                Classes="auto-tooltip" />
                        <Label VerticalAlignment="Center"
                               Foreground="Gray"
                               Content="{Binding Settings.MaxContentWidth, StringFormat={}{0:0} px}" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
                <controls:FASettingsExpanderItem Content="超长时滚动"
                                                 Description="内容超出最大宽度时来回滚动展示完整信息，而不是截断为省略号。"
                                                 IconSource="{ci:FluentIconSource &#xED91;}">
                    <controls:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsScrollWhenOverflow, Mode=TwoWay}" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander Margin="0,0,0,6"
                                         IconSource="{ci:FluentIconSource &#xE093;}"
                                         Header="左右间距"
                                         Description="启用后，对应侧的元素边界将收缩至适合圆角。">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="(左"
                               Foreground="Gray" />
                        <ToggleButton Margin="0,0,5,0"
                                      IsChecked="{Binding Settings.IsLeftNegativeMargin, Mode=TwoWay}" />
                        <Label Content="♪ --"
                               Foreground="Gray" />
                        <ToggleButton Margin="5,0,0,0"
                                      IsChecked="{Binding Settings.IsRightNegativeMargin, Mode=TwoWay}" />
                        <Label Content="右)"
                               Foreground="Gray" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <Label HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}">
                Powered by MediaIsland
            </Label>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>