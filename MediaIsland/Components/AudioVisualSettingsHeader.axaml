<UserControl x:Class="MediaIsland.Components.AudioVisualSettingsHeader"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:MediaIsland.SettingsPages">
    <StackPanel Spacing="4" Margin="0 0 0 12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <pages:ExperimentalBadge VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
