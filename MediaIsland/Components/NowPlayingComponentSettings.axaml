<ci:ComponentBase x:Class="MediaIsland.Components.NowPlayingComponentSettings"
                  x:TypeArguments="local:NowPlayingComponentConfig"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:controls="using:FluentAvalonia.UI.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:MediaIsland.Components"
                  mc:Ignorable="d"
                  d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:NowPlayingComponentSettings}}">
        <StackPanel>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE817;}" Header="暂停时隐藏组件"
                                         Description="当当前媒体暂停时，隐藏本组件。由于 ClassIsland 的设计特性，隐藏后仍存在一段空白。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsHideWhenPaused, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE9B2;}" Header="显示专辑封面"
                                         Description="显示当前播放的专辑封面。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsShowAlbumArt, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF401;}" Header="显示当前播放状态"
                                         Description="显示当前媒体的播放状态。">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsShowPlaybackStatus, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEDBF;}"
                                         Header="显示当前播放源"
                                         Description="显示当前媒体的播放源。"
                                         IsExpanded="{Binding Settings.IsShowSource, Mode=OneWay}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsShowSource, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
                <controls:FASettingsExpanderItem Content="显示当前播放源名称"
                                                 Description="显示当前媒体的播放源名称。"
                                                 IconSource="{ci:FluentIconSource &#xEBCB;}">
                    <controls:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsShowSourceName, Mode=TwoWay}" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
                <controls:FASettingsExpanderItem Content="图标圆角半径"
                                                 Description="播放源图标的圆角半径，默认为圆形。"
                                                 IconSource="{ci:FluentIconSource &#xF031;}">
                    <controls:FASettingsExpanderItem.Footer>
                        <Slider Width="160"
                                Minimum="0"
                                Maximum="16"
                                Value="{Binding Settings.SourceIconRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="0.5"
                                IsSnapToTickEnabled="True"
                                Classes="auto-tooltip" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEA97;}"
                                         Header="显示播放进度条"
                                         Description="在组件底部显示当前媒体播放进度（如果可用）。进度条颜色可在插件设置中配置。"
                                         IsExpanded="{Binding Settings.IsShowProgressBar, Mode=OneWay}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsShowProgressBar, Mode=TwoWay}" />
                </controls:FASettingsExpander.Footer>
                <controls:FASettingsExpanderItem Content="左右边距"
                                                 Description="为进度条对应侧增加内边距，避免贴边时被岛屿圆角裁切。"
                                                 IconSource="{ci:FluentIconSource &#xE093;}">
                    <controls:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="(左"
                                   Foreground="Gray" />
                            <ToggleButton Margin="0,0,5,0"
                                          IsChecked="{Binding Settings.IsProgressBarLeftMargin, Mode=TwoWay}" />
                            <Label Content="━━"
                                   Foreground="Gray" />
                            <ToggleButton Margin="5,0,0,0"
                                          IsChecked="{Binding Settings.IsProgressBarRightMargin, Mode=TwoWay}" />
                            <Label Content="右)"
                                   Foreground="Gray" />
                        </StackPanel>
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander Description="切换标题下方的信息显示。"
                                         Header="次要信息"
                                         IconSource="{ci:FluentIconSource &#xE9E4;}">
                <controls:FASettingsExpander.Footer>
                    <ComboBox MinWidth="110" SelectedIndex="{Binding Settings.SubInfoType}">
                        <ComboBoxItem>艺术家</ComboBoxItem>
                        <ComboBoxItem>时间轴（如果可用）</ComboBoxItem>
                    </ComboBox>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE091;}"
                                         Header="内容最大宽度"
                                         Description="限制歌曲名与艺术家区域的最大宽度，避免过长内容溢出覆盖右侧组件。拖到最左为 0，表示不限制。">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider Width="160"
                                Minimum="0"
                                Maximum="1000"
                                Value="{Binding Settings.MaxContentWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TickFrequency="20"
                                IsSnapToTickEnabled="True"
                                Classes="auto-tooltip" />
                        <Label VerticalAlignment="Center"
                               Foreground="Gray"
                               Content="{Binding Settings.MaxContentWidth, StringFormat={}{0:0} px}" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
                <controls:FASettingsExpanderItem Content="超长时滚动"
                                                 Description="内容超出最大宽度时来回滚动展示完整信息，而不是截断为省略号。"
                                                 IconSource="{ci:FluentIconSource &#xED91;}">
                    <controls:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsScrollWhenOverflow, Mode=TwoWay}" />
                    </controls:FASettingsExpanderItem.Footer>
                </controls:FASettingsExpanderItem>
            </controls:FASettingsExpander>
            <controls:FASettingsExpander Margin="0,0,0,6"
                                         IconSource="{ci:FluentIconSource &#xE093;}"
                                         Header="左右间距"
                                         Description="启用后，对应侧的元素边界将收缩至适合圆角。">
                <controls:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="(左"
                               Foreground="Gray" />
                        <ToggleButton Margin="0,0,5,0"
                                      IsChecked="{Binding Settings.IsLeftNegativeMargin, Mode=TwoWay}" />
                        <Label Content="■ -- ●"
                               Foreground="Gray" />
                        <ToggleButton Margin="5,0,0,0"
                                      IsChecked="{Binding Settings.IsRightNegativeMargin, Mode=TwoWay}" />
                        <Label Content="右)"
                               Foreground="Gray" />
                    </StackPanel>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <Label HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}">
                Powered by MediaIsland
            </Label>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>